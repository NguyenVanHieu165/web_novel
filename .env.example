# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DATABASE?sslaccept=strict"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="web_novel"
DATABASE_PASSWORD="replace-me"
DATABASE_NAME="web_novel"
DATABASE_SSL="true"
DATABASE_SSL_CA=""
DATABASE_CONNECTION_LIMIT="10"
DATABASE_CONNECT_TIMEOUT="15000"

# Authentication
JWT_SECRET="replace-with-at-least-32-random-characters"
ADMIN_IMPORTED_USER_PASSWORD="replace-with-a-temporary-strong-password"
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# Realtime server and background worker
INTERNAL_SECRET_TOKEN="replace-with-an-independent-random-token"
SOCKET_SERVER_URL="http://localhost:3001"
NEXT_PUBLIC_SOCKET_SERVER_URL="http://localhost:3001"
INTERNAL_API_URL="http://127.0.0.1:3000"
ALLOWED_ORIGINS="http://localhost:3000"
PORT="3001"
WORKER_ENABLED="true"
JOB_CONCURRENCY="1"
JOB_LEASE_MS="90000"
JOB_HEARTBEAT_MS="20000"
JOB_POLL_MS="5000"
JOB_IDLE_POLL_MS="15000"

# Public web URL used by browser API requests
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Cloudinary
CLOUDINARY_CLOUD_NAME="replace-with-cloud-name"
CLOUDINARY_API_KEY="replace-with-api-key"
CLOUDINARY_API_SECRET="replace-with-api-secret"

# SePay
SEPAY_BANK_CODE="replace-with-bank-code"
SEPAY_ACCOUNT_NUMBER="replace-with-account-number"
SEPAY_ACCOUNT_NAME="replace-with-account-name"
SEPAY_WEBHOOK_API_KEY="replace-with-webhook-api-key"

NODE_ENV="production"
COOKIE_SECURE="true"
