{
  "name": "lacatruyen-tts-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "r2_buckets": [
    {
      "binding": "TTS_BUCKET",
      "bucket_name": "lacatruyen-tts"
    }
  ],
  "vars": {
    "VERCEL_TTS_RELAY_URL": "https://web-novel-ete3.vercel.app/api/internal/tts-relay"
  }
}
