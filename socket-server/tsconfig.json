{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": ["server.ts", "worker.ts", "auth/**/*.ts", "handlers/**/*.ts", "rooms/**/*.ts", "worker/**/*.ts", "jobs/**/*.ts", "importer/**/*.ts", "onlineStats.ts"]
}
