{
  "name": "socket-server",
  "version": "1.0.0",
  "description": "Standalone Socket.IO TypeScript Server for Web Novel Notifications",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node supervisor.mjs",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch server.ts",
    "dev:worker": "tsx watch worker.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "5.3.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "mariadb": "^3.5.4",
    "socket.io": "4.8.4",
    "yjs": "^13.6.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "5.0.6",
    "@types/node": "^20.11.24",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
